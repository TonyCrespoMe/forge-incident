# ForgeIncident environment configuration
# Copy this file to .env and fill in only what you need.
# ForgeIncident works FULLY OFFLINE with no keys set — the "none" LLM
# backend (deterministic, rule-based scenario expansion) is the default.
# Claude, OpenAI, Gemini, Grok, and Ollama are all optional extras for
# natural-language scenario *planning* only (picking which bundled
# template to use + a difficulty/title) — none of them ever touch
# log/artifact generation, which is always deterministic Python driven by
# the shared event model. You only need ONE of the keys below, matching
# whichever FORGE_LLM_BACKEND you pick — most people need none of them.

# --- LLM backend selection ---
# One of: none | claude | openai | gemini | grok | ollama
FORGE_LLM_BACKEND=none

# --- Claude (Anthropic API) backend --- pip install "forge-incident[claude]"
# Get a key at https://console.anthropic.com/settings/keys
# Required only if FORGE_LLM_BACKEND=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI (ChatGPT/GPT) backend --- pip install "forge-incident[openai]"
# Get a key at https://platform.openai.com/api-keys
# Required only if FORGE_LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Google Gemini backend --- pip install "forge-incident[gemini]"
# Get a key at https://aistudio.google.com/apikey
# Required only if FORGE_LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- xAI Grok backend --- pip install "forge-incident[grok]"
# Get a key at https://console.x.ai
# Required only if FORGE_LLM_BACKEND=grok
XAI_API_KEY=
GROK_MODEL=grok-2-latest

# --- Ollama (local LLM) backend --- pip install "forge-incident[ollama]"
# Requires `ollama serve` running locally with OLLAMA_MODEL already pulled.
# Required only if FORGE_LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Generation defaults ---
# Deterministic seed used when none is supplied on the CLI.
FORGE_DEFAULT_SEED=1337

# Directory where generated student/instructor packages are written.
FORGE_OUTPUT_DIR=./output

# --- Logging ---
# One of: DEBUG | INFO | WARNING | ERROR
FORGE_LOG_LEVEL=INFO
